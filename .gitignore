# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/*
!.claude/agents/
!.claude/commands/
!.claude/hooks/
.aider*
.env.local

# non-source assets (docs Notion exportées, logo, rapports de setup)
# UN SLASH INITIAL, sinon le motif vaut à TOUTE profondeur. `logo/` ignorait aussi `public/logo/`
# et `src/app/dev/logo/`, donc des fichiers qui n'atteignaient jamais la production sans que rien
# ne le dise. Corrigé le 02/08/2026 : ces trois motifs ne visent que la racine.
/Documentation Notion/
/logo/
/posthog-setup-report.md

# Bannières sources (les WebP optimisées vivent dans public/covers)
/Photos/
# Exports design system locaux
*Design System.html
*Design System.pdf

# Caches bruts régénérables (comparateur de vie) — l'index buildé est versionné, pas les extractions brutes
data/communes-population.json
data/communes-vivabilite.json

# Copie de travail de l'index (artefact canonique = comparateur-index.json.gz)
data/comparateur-index.json

# Sources INSEE emploi brutes (~250 Mo) — non versionnées ; les caches dérivés
# data/communes-emploi.json et data/ze-emploi-na38.json le sont (cf. altitude).
data/source/DS_FLORES_A38_2024_CSV_FR.zip
data/source/DS_FLORES_A38_2024_data.csv
data/source/DS_FLORES_A38_2024_metadata.csv
data/source/ZE2020_au_01-01-2026.zip
data/source/ZE2020_au_01-01-2026.xlsx
data/source/_probe_ze.mjs

# Caches bruts logement (DVF ~420 Mo + ANIL) — non versionnés ; le dérivé vit dans l'index
data/cache-logement/

# Cache brut nature (OSO 2023 ~737 Mo + contours) — non versionné ; le dérivé vit dans l'index
data/cache-nature/

# Cache brut INSEE logement (base-cc-logement ~40 Mo) — non versionné ; le dérivé
# vit dans data/residences-secondaires.json
data/cache-saisonnalite/

# BPE : venv dédié + sources parquet locales (non versionnées ; cf. l'en-tête de
# scripts/populate-bpe.py pour la commande de téléchargement Insee)
.venv-bpe/
data/bpe24.parquet
data/bpe25.parquet
data/.cache/

# Table d appartenance UU2020 (source locale, non versionnée)
data/uu2020.xlsx

# Python
__pycache__/
*.pyc

# RP MOBPRO (volumineux, non versionné)
data/rp-mobpro-2022.parquet

# Captures/scripts de debug temporaires
.tmp-audit-screenshots/

# Sorties de spikes de recherche (regenerables par scripts/research/)
/tmp/

# ── SAUVEGARDES LOCALES DE DONNÉES RÉELLES ────────────────────────────────────────────────────
# Photographies d'un état de la base de production (artefacts avant régénération, exports de
# vérification). Elles portent des données personnelles et ne doivent jamais entrer au dépôt, mais
# elles valent mieux que /tmp : ce sont les seules fixtures d'une migration future.
.prive/

# Pack charte livré par la designer : 92 Mo de PDF et de zips, dont un zip de 33 Mo. Ce que le CODE
# consomme (SVG du logo, tokens, polices) est versionné ailleurs ; les livrables sources restent
# hors du dépôt, parce qu'un binaire poussé une fois ne quitte plus jamais l'historique.
CHARTE/
Futur.e Design System.zip

# État local de l'outil « impeccable » (config de poste, cache de hook, captures de travail).
.impeccable/
